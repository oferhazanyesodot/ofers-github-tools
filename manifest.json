{
  "manifest_version": 3,
  "name": "GitHub PR Bookmark Folder",
  "version": "1.0.0",
  "description": "Automatically maintains a bookmark folder with your open GitHub Pull Requests, using your existing GitHub session.",
  "permissions": [
    "bookmarks",
    "alarms",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

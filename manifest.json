{
  "manifest_version": 3,
  "name": "Ofer's GitHub Tools",
  "version": "2.0.0",
  "description": "A personal GitHub toolkit: auto-syncing PR bookmark folder, Copilot usage tracking with burn-rate projections, and more — all using your existing GitHub session.",
  "permissions": [
    "bookmarks",
    "alarms",
    "storage",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "sync-now": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Sync PRs now"
    }
  }
}
